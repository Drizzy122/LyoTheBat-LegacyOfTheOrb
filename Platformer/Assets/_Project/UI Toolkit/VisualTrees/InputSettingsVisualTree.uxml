                <ui:Toggle label="" text="Disabled" value="false" toggle-on-label-click="true" enabled="true" name="InvertMouseY" style="left: 695px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            </ui:Label>
