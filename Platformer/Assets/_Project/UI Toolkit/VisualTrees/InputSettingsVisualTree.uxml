            <ui:Label text="INPUT SETTINGS" name="InputSettingsHeader" class="Text" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/Ottselesque-Regular.otf?fileID=12800000&amp;guid=b00bfdbd79d843a46b8b3fb62f619d32&amp;type=3#Ottselesque-Regular&quot;); font-size: 50px; height: 253px; width: 347px; flex-direction: column; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: -96px;"/>
            <ui:Label text="Controller Vibration" name="ControllerVibrate" selectable="true" focusable="true" class="Text" style="color: rgb(255, 255, 255); font-size: 29px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); background-color: rgba(92, 92, 92, 0.78); -unity-text-align: middle-left; flex-direction: row; height: 53px;">
                <ui:Toggle label="" text="Disabled" value="false" toggle-on-label-click="true" enabled="true" name="MotionBlurToggle" style="left: 695px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 49px;"/>
