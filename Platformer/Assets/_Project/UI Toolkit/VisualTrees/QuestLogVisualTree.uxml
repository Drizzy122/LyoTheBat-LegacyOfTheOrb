<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/QuestLogStyle.uss?fileID=7433441132597879392&amp;guid=f6366ca6a5c9b8f42bf1e0f758ad100d&amp;type=3#QuestLogStyle"/>
    <ui:VisualElement name="QuestLogContainer" class="quest-overlay" style="display: flex;">
        <ui:VisualElement class="quest-backdrop"/>
        <ui:VisualElement class="quest-panel">
            <ui:VisualElement class="quest-header">
                <ui:VisualElement class="quest-header-line"/>
                <ui:Label text="QUEST LOG" class="quest-title"/>
                <ui:VisualElement class="quest-header-line"/>
            </ui:VisualElement>
            <ui:VisualElement class="quest-divider"/>
            <ui:VisualElement class="quest-body">
                <ui:VisualElement class="quest-list-panel">
                    <ui:ScrollView name="QuestScrollView" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="quest-list-scroll"/>
                </ui:VisualElement>
                <ui:VisualElement class="quest-vert-rule"/>
                <ui:VisualElement class="quest-detail-panel">
                    <ui:Label name="QuestNameLabel" text="Select a quest" class="quest-name"/>
                    <ui:VisualElement class="quest-name-rule"/>
                    <ui:Label name="QuestStatusLabel" text="" class="quest-status"/>
                    <ui:VisualElement class="quest-section">
                        <ui:Label text="REWARDS" class="quest-section-header"/>
                        <ui:VisualElement class="quest-section-rule"/>
                        <ui:Label name="GoldRewardLabel" text="" class="quest-info-text"/>
                        <ui:Label name="ExperienceRewardLabel" text="" class="quest-info-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="quest-section">
                        <ui:Label text="REQUIREMENTS" class="quest-section-header"/>
                        <ui:VisualElement class="quest-section-rule"/>
                        <ui:Label name="LevelReqLabel" text="" class="quest-info-text"/>
                        <ui:Label name="QuestReqLabel" text="" class="quest-info-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="← Close" name="CloseButton" class="quest-close-btn"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
