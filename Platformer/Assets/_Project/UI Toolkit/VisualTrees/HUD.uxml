    <Style src="project://database/Assets/_Project/UI%20Toolkit/QuestStyle.uss?fileID=7433441132597879392&amp;guid=262dfd09358cb4644a169f44e7cc8489&amp;type=3#QuestStyle"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/player.uss?fileID=7433441132597879392&amp;guid=fa9c46055221b644c931aea204e2d9d9&amp;type=3#player"/>
    <ui:VisualElement name="HUD" style="flex-grow: 1; display: flex;">
        <ui:Image name="MissionBoxContainer" style="width: 563px; height: 241px; top: 248px; background-color: rgba(0, 0, 0, 0); border-top-right-radius: 0; border-bottom-right-radius: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 0;">
            <ui:Image style="height: 20px; width: 20px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: -8px; border-top-right-radius: -8px; border-bottom-right-radius: -8px; border-bottom-left-radius: -8px; background-color: rgba(0, 0, 0, 0); position: absolute; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; top: 57px; left: 15px;"/>
            <ui:Label text="QuestTitle" name="QuestTitle" class="Text" style="font-size: 27px; color: rgb(255, 255, 255); -unity-text-align: upper-center; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-bottom-width: 4px; background-color: rgba(0, 58, 255, 0.27); width: 565px; height: 39px; top: -31px; right: 4px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;);"/>
            <ui:Label text="Explore the Area" name="QuestStatus" class="Text" style="font-size: 22px; color: rgb(255, 255, 255); -unity-text-align: upper-left; height: 183px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); white-space: normal; left: 38px; width: 516px;"/>
        </ui:Image>
        <ui:VisualElement name="WaypointContainer" style="flex-grow: 1; position: absolute; height: 62px; width: 68px; top: 268px; left: 1319px; background-image: url(&quot;project://database/Assets/_Project/Art/Modern%20GDR%20-%20Free%20icons%20pack/00_Atlas/BrightIcons.png?fileID=37255795&amp;guid=132358e9bf26b60458b731bf001e31db&amp;type=3#ToggleOn_Bright&quot;); background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255);">
            <ui:Label text="100m" name="MeterLabel" class="Text" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); font-size: 21px; -unity-text-align: upper-center; top: 59px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="DialogueContainer" style="flex-grow: 1; top: 920px; height: 111px; position: absolute; width: 875px; left: 500px; display: none; background-color: rgba(0, 0, 0, 0.31);">
            <ui:Label text="Greetings, Guardian. The path ahead is fraught with danger, but I sense a great light within you. The bugs and plague bats have overrun the abandoned island. Are you ready to begin your journey and clear them out, or do you need more time to prepare?" name="DialogueText" class="Text" style="height: 106px; white-space: pre-wrap; font-size: 21px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); -unity-text-align: upper-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ChoicesContainer" style="flex-grow: 1; position: absolute; height: 194px; top: 480px; width: 572px; left: 1316px; background-color: rgba(0, 0, 0, 0.5); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; display: none;">
            <ui:Button text="Button" name="Choice1" class="dialogue-choice-button"/>
            <ui:Button text="Button" name="Choice2" class="dialogue-choice-button"/>
            <ui:Button text="Button" name="Choice3" class="dialogue-choice-button"/>
            <ui:Button text="Button" name="Choice4" class="dialogue-choice-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="NotificationContainer" style="flex-grow: 1; position: absolute; height: 139px; width: 1922px; top: 39px; left: -4px; background-color: rgba(0, 0, 0, 0.5); border-left-color: rgb(121, 199, 255); border-right-color: rgb(121, 199, 255); border-top-color: rgb(121, 199, 255); border-bottom-color: rgb(121, 199, 255); border-top-width: 9px; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; transition-timing-function: ease-in-bounce; transition-duration: 8s;">
            <ui:Label text="Notifications will apear here" name="NotificationText" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); color: rgb(255, 255, 255); font-size: 26px; -unity-text-align: middle-center; height: 121px; -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-font-style: bold; width: 514px; left: 728px;"/>
            <ui:Image source="project://database/Assets/_Project/Art/Modern%20GDR%20-%20Free%20icons%20pack/00_Atlas/BrightIcons.png?fileID=1314314700&amp;guid=132358e9bf26b60458b731bf001e31db&amp;type=3#Quest01_Bright" style="position: absolute; top: 7px; left: 633px; height: 117px; width: 138px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="StaminaContainer" class="staminabar-container" style="top: 970px; left: 155px; height: 17px; width: 287px; background-color: rgb(0, 2, 115); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
            <ui:VisualElement name="StaminaBar" class="staminabar" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="HealthContainer" class="healthbar-container" style="top: 910px; left: 155px; height: 30px; width: 286px; background-color: rgb(6, 108, 0); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
            <ui:VisualElement name="HealthBar" class="healthbar" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgb(1, 255, 0);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
