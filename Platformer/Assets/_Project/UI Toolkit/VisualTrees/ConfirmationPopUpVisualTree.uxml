<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=1e607d4d39bbf3c4aa48749712dc3062&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="ConfirmationPopupMenuContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
        <ui:Image tint-color="rgb(255, 255, 255)" style="background-color: rgb(0, 0, 0); height: 439px; width: 801px; right: auto; bottom: -245px; align-self: center; border-top-left-radius: 47px; border-top-right-radius: 47px; border-bottom-right-radius: 47px; border-bottom-left-radius: 47px; display: flex; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px;">
            <ui:Label text="Are you sure you want to delete this save data??" name="DisplayText" style="color: rgb(255, 255, 255); -unity-text-align: middle-center; font-size: 40px; bottom: auto; height: 428px; -unity-font-style: normal; white-space: normal; flex-direction: row; text-overflow: ellipsis; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); background-color: rgba(0, 0, 0, 0); filter: tint(rgb(255, 0, 0)); align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Button text="CONFIRM" name="ConfirmButton" class="button" style="top: 312px; right: auto; height: 56px; width: 334px; font-size: 33px; transition-duration: 0.35s; transition-timing-function: ease-in-out-bounce; position: absolute; left: 40px; -unity-text-align: middle-center; -unity-background-image-tint-color: rgba(255, 255, 255, 0); align-self: center; bottom: auto;"/>
            <ui:Button text="CANCEL" name="CancelButton" class="button" style="top: 312px; right: auto; height: 56px; width: 334px; font-size: 33px; transition-duration: 0.35s; transition-timing-function: ease-in-out-bounce; position: absolute; left: 405px; -unity-text-align: middle-center; -unity-background-image-tint-color: rgba(255, 255, 255, 0); align-self: center; bottom: auto;"/>
        </ui:Image>
    </ui:VisualElement>
</ui:UXML>
