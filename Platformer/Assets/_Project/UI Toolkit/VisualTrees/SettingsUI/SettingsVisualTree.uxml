<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="AudioSettingsVisualTree" src="project://database/Assets/_Project/UI%20Toolkit/VisualTrees/SettingsUI/AudioSettingsVisualTree.uxml?fileID=9197481963319205126&amp;guid=bc1508cc7ea04c64693a259c79b6e2c1&amp;type=3#AudioSettingsVisualTree"/>
    <ui:Template name="ControllerVisualTree" src="project://database/Assets/_Project/UI%20Toolkit/VisualTrees/SettingsUI/ControllerVisualTree.uxml?fileID=9197481963319205126&amp;guid=da415f83be99d42449ba74f07950c01f&amp;type=3#ControllerVisualTree"/>
    <ui:Template name="InputSettingsVisualTree" src="project://database/Assets/_Project/UI%20Toolkit/VisualTrees/SettingsUI/InputSettingsVisualTree.uxml?fileID=9197481963319205126&amp;guid=bf6d6575a4305ce43be39becf3570bfc&amp;type=3#InputSettingsVisualTree"/>
    <ui:Template name="VideoSettingsVisualTree" src="project://database/Assets/_Project/UI%20Toolkit/VisualTrees/SettingsUI/VideoSettingsVisualTree.uxml?fileID=9197481963319205126&amp;guid=af07c988c2432024e8509393ae4ac803&amp;type=3#VideoSettingsVisualTree"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=1e607d4d39bbf3c4aa48749712dc3062&amp;type=3#MainMenuStyle"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/TabViewStyle.uss?fileID=7433441132597879392&amp;guid=27fa83c6f936c03468a82829f3f3de7d&amp;type=3#TabViewStyle"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/Sliders.uss?fileID=7433441132597879392&amp;guid=75107247cfbf21d45bd25fc08921f8d5&amp;type=3#Sliders"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/Toggles.uss?fileID=7433441132597879392&amp;guid=556ece4fc6adc734d95e8d4ea03bd7ae&amp;type=3#Toggles"/>
    <ui:VisualElement name="SettingsContainer" style="flex-grow: 1; flex-direction: column; background-color: rgba(5, 3, 15, 0.96); display: flex;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; position: relative;">
            <ui:VisualElement name="Border" style="position: absolute; left: 340px; top: 0; bottom: 0; width: 2px; background-color: rgba(190, 150, 50, 0.35);"/>
            <ui:TabView style="flex-grow: 1; border-width: 0;">
                <ui:Tab label="Audio" name="AudioTab">
                    <ui:Instance template="AudioSettingsVisualTree"/>
                </ui:Tab>
                <ui:Tab label="Video" name="VideoTab">
                    <ui:Instance template="VideoSettingsVisualTree"/>
                </ui:Tab>
                <ui:Tab label="Input" name="InputSettingsTab">
                    <ui:Instance template="InputSettingsVisualTree"/>
                </ui:Tab>
                <ui:Tab label="Controller" name="ControllerTab">
                    <ui:Instance template="ControllerVisualTree"/>
                </ui:Tab>
            </ui:TabView>
        </ui:VisualElement>
        <ui:Button text="← Back" name="BackButton" class="back-btn"/>
    </ui:VisualElement>
</ui:UXML>
