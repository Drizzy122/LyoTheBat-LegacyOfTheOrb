<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=1e607d4d39bbf3c4aa48749712dc3062&amp;type=3#MainMenuStyle"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/TabViewStyle.uss?fileID=7433441132597879392&amp;guid=27fa83c6f936c03468a82829f3f3de7d&amp;type=3#TabViewStyle"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/Sliders.uss?fileID=7433441132597879392&amp;guid=75107247cfbf21d45bd25fc08921f8d5&amp;type=3#Sliders"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/Toggles.uss?fileID=7433441132597879392&amp;guid=556ece4fc6adc734d95e8d4ea03bd7ae&amp;type=3#Toggles"/>

    <ui:VisualElement style="flex-grow: 1; display: flex; flex-direction: column;">
        <ui:VisualElement name="VideoRow" class="settings-content-area">

            <ui:Label text="VIDEO" name="VideoHeader" class="settings-section-header" />
            <ui:VisualElement class="settings-separator" />

            <!-- Window Mode -->
            <ui:Label text="Window Mode" name="WindowMode" class="settings-row">
                <ui:Button name="WindowPrevButton" class="settings-cycle-btn" style="background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle%201.png?fileID=2800000&amp;guid=f3d43f75a236200498d70b747797fb22&amp;type=3#Triangle 1&quot;);" />
                <ui:Label text="FullScreen" name="WindowValueText" class="settings-value-label" />
                <ui:Button name="WindowNextButton" class="settings-cycle-btn" style="background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle.png?fileID=2800000&amp;guid=72106216895893945a478e9675f068f6&amp;type=3#Triangle&quot;);" />
            </ui:Label>

            <!-- Resolution -->
            <ui:Label text="Resolution" name="Resolution" class="settings-row settings-row-alt">
                <ui:Button name="ResPrevButton" class="settings-cycle-btn" style="background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle%201.png?fileID=2800000&amp;guid=f3d43f75a236200498d70b747797fb22&amp;type=3#Triangle 1&quot;);" />
                <ui:Label text="1920x1080" name="ResValueText" class="settings-value-label" />
                <ui:Button name="ResNextButton" class="settings-cycle-btn" style="background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle.png?fileID=2800000&amp;guid=72106216895893945a478e9675f068f6&amp;type=3#Triangle&quot;);" />
            </ui:Label>

            <!-- Graphics Quality -->
            <ui:Label text="Graphics Quality" name="GraphicsQuality" class="settings-row">
                <ui:Button name="QualityPrevButton" class="settings-cycle-btn" style="background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle%201.png?fileID=2800000&amp;guid=f3d43f75a236200498d70b747797fb22&amp;type=3#Triangle 1&quot;);" />
                <ui:Label text="Very High" name="QualityValueText" class="settings-value-label" />
                <ui:Button name="QualityNextButton" class="settings-cycle-btn" style="background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle.png?fileID=2800000&amp;guid=72106216895893945a478e9675f068f6&amp;type=3#Triangle&quot;);" />
            </ui:Label>

            <!-- Gamma slider -->
            <ui:Slider label="Gamma" value="42" high-value="100" name="GammaSlider" fill="true" />

            <!-- Motion Blur toggle -->
            <ui:Label text="Motion Blur" name="MotionBlur" class="settings-row settings-row-alt">
                <ui:Toggle name="MotionBlurToggle" value="false" toggle-on-label-click="true" />
            </ui:Label>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
