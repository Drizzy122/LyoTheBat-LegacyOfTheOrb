            <ui:Label text="Window Mode" name="WindowMode" class="Text" style="color: rgb(255, 255, 255); font-size: 23px; -unity-font-definition: url(&quot;project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&amp;guid=6384753b77039dc43a7bf85678bfc68d&amp;type=3#MyFont&quot;); background-color: rgba(92, 92, 92, 0.78); -unity-text-align: middle-left; flex-direction: row; height: 47px;">
