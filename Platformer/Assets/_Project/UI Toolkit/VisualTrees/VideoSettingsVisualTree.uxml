                <ui:Button text="" name="QualityPrevButton" style="width: 30px; left: 728px; height: 33px; background-image: url(&quot;project://database/Assets/_Project/Art/MyArt/Triangle%201.png?fileID=2800000&amp;guid=f3d43f75a236200498d70b747797fb22&amp;type=3#Triangle 1&quot;); background-color: rgba(0, 0, 0, 0); align-self: flex-end;"/>
